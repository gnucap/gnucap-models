SECTION = nonfree/bsim4va
MODEL = bsim4
TARGET = $(MODEL) $(MODEL)_nmos $(MODEL)_pmos
PLUGINS_SO = ${TARGET:%=%.so}

TESTDIR = ../../bsim/tests
TESTCASES = b4_

TEST_PARAMSET_SELECT = compiled

ifeq ($(TEST_PARAMSET_SELECT), compiled)
  TEST_PLUGINS = $(MODEL)_nmos.so $(MODEL)_pmos.so
  GNUCAP_INCLUDES =
else ifeq ($(TEST_PARAMSET_SELECT), interpreted)
  TEST_PLUGINS = $(MODEL).so
  GNUCAP_INCLUDES = -i modelcard.nmos.paramset -i modelcard.pmos.paramset
endif

${MODEL}_pmos.cc: ${MODEL}.va
${MODEL}_nmos.cc: ${MODEL}.va

GNUCAP_INCLUDES += -i test_config.parameter

#BUG: workaround excessive iterations in op
GNUCAP_OPTIONS = --options\ vmin=0.0\ vmax=0.0

GNUCAP_ARGS = -a mgsim ${TEST_PLUGINS:%=-a ./%} ${GNUCAP_INCLUDES} ${GNUCAP_OPTIONS}
