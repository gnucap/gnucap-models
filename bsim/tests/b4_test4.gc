* NMOS Id-Vg

verilog

module main(d);
  output d;
  electrical d;
  ground gnd;

  parameter real vd = 0.;
  parameter real vg = 0.;

  vsource #(.dc(vd)) sd(d, gnd);
  vsource #(.dc(vg)) sg(g, gnd);

  N1 #(.l(0.09u), .w(10.0u)) M1(.d(d), .g(g), .s(gnd), .b(gnd));
endmodule

parameter real vd = 0.;
parameter real vg = 0.;
main #(.vd(vd), .vg(vg)) m(d);

// list N1
list main

print dc v(d) i(m.sd) iter(0)
dc vg 0 1.2 0.02 vd 0.05 1.2 0.5 basic
status notime
