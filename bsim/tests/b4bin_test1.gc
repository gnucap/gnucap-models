* NMOS bin test
* options debug
delete N1
delete P1

.MODEL BINTEST NMOS   LEVEL = 14 Lmin=1 Lmax=5 Wmin=0.6 Wmax=20 VTH0=0.4
.MODEL BINTEST.1 NMOS LEVEL = 14 Lmin=5 Lmax=9 Wmin=0.6 Wmax=20 VTH0=0.5

* Enable Verilog mode
verilog

module tb(d,g,s,b);
  ground \0 ;
  BINTEST #(.l(1), .w(1), .nf(5)) M1(.d(d), .g(g), .s(s), .b(b));
  BINTEST #(.l(6), .w(1), .nf(5)) M2(.d(d), .g(g), .s(s), .b(b));
endmodule

tb t(d,g,s,b);

vsource #(.dc(vd)) sd(d , \0 );
vsource #(.dc(vg)) sg(g , \0 );
vsource #(.dc(vs)) sb(s , \0 );
vsource #(.dc(vb)) sb(b , \0 );
parameter vd = 0.0;
parameter vg = 0.0;
parameter vs = 0.0;
parameter vb = 0.0;

list tb t
print dc id(t.*) iter(0)
dc vd 0 1.2 0.2 vg 0.2 1.2 0.2 basic
spice
.list BINT*
.status notime
