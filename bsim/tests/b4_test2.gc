* NMOS Id-Vd @ -55C
*load mgsim
*load ../BSIM483/bsim483.so
*include ../BSIM481/benchmark_test/modelcard.nmos

* Enable Verilog mode
verilog

// Set temperature
option temp=-55.0

// Define ground
ground \0 ;

// Declare voltage sources (drain, gate, source, bulk)
vsource #(.dc(vb)) sb(b , \0 );
vsource #(.dc(vs)) sb(s , \0 );
vsource #(.dc(vd)) sd(d , \0 );
vsource #(.dc(vg)) sg(g , \0 );

// Assign initial voltages
parameter vd = 0.0 // Drain (will be overwritten during sweep)
parameter vg = 0.0 // Gate (will be overwritten during sweep)
parameter vb = 0.0 // Source (fixed)
parameter vs = 0.0 // Bulk (fixed)

// Instantiate NMOS transistor using bsim480 model
N1 #(.l(0.09u), .w(10.0u)) M1(.d(d), .g(g), .s(s), .b(b));

// Simulation control
list
print dc v(g) i(sd) iter(0)
dc vd 0.0 1.2 0.02 vg 0.0 1.2 0.2 basic
status notime