* PMOS Id-Vg with Vb @ 100C

* Enable Verilog mode
verilog

option temp = 100.0

ground \0 ;

vsource #(.dc(vd)) sd(d , \0 );
vsource #(.dc(vg)) sg(g , \0 );
vsource #(.dc(vs)) sb(s , \0 );
vsource #(.dc(vb)) sb(b , \0 );

parameter vd = -0.1;
parameter vg = 0.0;
parameter vs = 0.0;
parameter vb = 0.0;

P1 #(.l(0.09u), .w(10.0u)) M1(.d(d), .g(g), .s(s), .b(b));

list
print dc v(b) i(sd) iter(0)
dc vg 0.6 -1.2 -0.02 vb 0 1.2 0.3 basic
status notime