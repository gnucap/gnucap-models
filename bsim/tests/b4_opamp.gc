* Operational amplifier (ac) ported from BSIM481/benchmark_test/opamp.b4
*load mgsim
load vams/vsine.so
load vams/vcvs.so
* load ../BSIM483/bsim483.so
*include ../BSIM481/benchmark_test/modelcard.nmos
*include ../BSIM481/benchmark_test/modelcard.pmos

* Enable verilog mode
verilog

options numdgt=7
options reltol = 1e-5

// Declare ground
ground \0 ;

// ported from BSIM481/benchmark_test/opamp.b4
// port in1=1
// port vout=8

vsine #(.mag(0.1) .dc(0.0)) Vid(in1, c);
vcvs #(.gain(-1.0), .offset(0.0)) Eid(in2, c, in1, c);
// what's the point of having 0.0 source
vsource #(.dc(0.0)) Vic(c, \0 );
vsource #(.dc(-1.8)) Vss(vss, \0 );
vsource #(.dc(+1.8)) Vdd(vdd, \0 );

N1 #(.w(10u), .l(0.09u)) M1(.d(bias1), .g(in1),   .s(cm),  .b(cm));
N1 #(.w(10u), .l(0.09u)) M2(.d(bias2), .g(in2), .s(cm),  .b(cm));

P1 #(.w(2u),  .l(0.09u)) M3(.d(vdd), .g(bias1), .s(bias1), .b(vdd));
P1 #(.w(2u),  .l(0.09u)) M4(.d(bias2), .g(bias1), .s(vdd), .b(vdd));

N1 #(.w(2u),  .l(0.09u)) M5(.d(cm),    .g(bias), .s(vss),   .b(vss));
N1 #(.w(2u),  .l(0.09u)) Mbias(.d(bias), .g(bias), .s(vss), .b(vss));

N1 #(.w(2u),  .l(0.09u)) M6(.d(vout), .g(bias), .s(vss),   .b(vss));
N1 #(.w(2u),  .l(0.09u)) M7(.d(vout), .g(bias2), .s(vdd),  .b(out));

// Resistor bias
resistor #(.r(195k)) Rbias(\0 , bias);

// Feedback capacitor
capacitor #(.c(2p)) Cfb(bias2, vout);

// Simulation control 
list

print dc v(in1) v(in2) v(vout)
dc
print ac vdb(vout) iter(0)
ac dec 10 100 100Meg basic
status notime