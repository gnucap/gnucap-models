* One-shot trigger (tran) adopted from BSIM481/benchmark_test/gstage.b4

load vams/vsine.so
verilog

options numdgt=7

ground \0 ;

resistor #(.r(100k)) Rsource(in, g);
resistor #(.r(25k)) Rload(d, vdd);

N1 #(.w(4u), .l(0.09u)) M1(.d(d), .g(g), .s(\0 ), .b(\0 ));

vsource #(.dc(vscale*1.8)) Vdd(vdd, \0 );
// TODO
vsine #(.mag(0.1) .dc(1.2)) Vin(in, \0 );

list
print ac vdb(d) iter(0)
dc
ac dec 10 100 1000Meg basic
status notime

