parameter real vscale = 0.66666666;
// MOSFET noise test
module noise_test ();
  ground gnd;
  N1 #(.l(0.09u),.w(10.0u)) M1 (.d(out),.g(g),.s(gnd),.b(gnd));
  resistor #(.r(10k),.noisy(1.0)) RD (vdd, out);
  vsource #(.dc(1.2)) Vdd (vdd, gnd);
  vsource #(.dc(0.6)) Vg (g, gnd);
  noise_probe #() n_total (out);
  noise_probe #(.name("flicker")) n_flicker (out);
endmodule // noise_test

