paramset N1 PSP104VA;
  parameter real l=1.0u;
  parameter real w=1.0u;
  parameter integer nf=1;
  parameter real ad=1.0e-12;
  parameter real pd=1.0e-6;
  parameter real as=1.0e-12;
  parameter real ps=1.0e-6;
  parameter real sa=0.0;
  parameter real sb=0.0;
  parameter real sd=0.0;
 .TYPE=1; .L=l; .W=w; .NF=nf; .AD=ad; .PD=pd; .AS=as; .PS=ps; .SA=sa; .SB=sb; .SD=sd;
endparamset

paramset P1 PSP104VA;
  parameter real l=1.0u;
  parameter real w=1.0u;
  parameter integer nf=1;
  parameter real ad=1.0e-12;
  parameter real pd=1.0e-6;
  parameter real as=1.0e-12;
  parameter real ps=1.0e-6;
  parameter real sa=0.0;
  parameter real sb=0.0;
  parameter real sd=0.0;
 .TYPE=(- 1); .L=l; .W=w; .NF=nf; .AD=ad; .PD=pd; .AS=as; .PS=ps; .SA=sa; .SB=sb; .SD=sd;
endparamset

parameter real vscale = 0.66666666; 
ground \0 ;
// cmos inverter
module not1 (.z(z),.a(a),.vss(vss),.vdd(vdd));
  P1 #(.l(0.18u),.w(10u),.ad(5p),.pd(22u),.as(5p),.ps(22u),.sa(2u),.sb(8u),.nf(3),.sd(0.2u)) m01 (.d(z),.g(a),.s(vdd),.b(vdd));
  N1 #(.l(0.18u),.w(5u),.ad(5p),.pd(22u),.as(5p),.ps(22u),.sa(2u),.sb(8u),.nf(3),.sd(0.2u)) m02 (.d(z),.g(a),.s(vss),.b(vss));
endmodule // not1

// 17-stage ring oscillator
resistor #(.r(1G)) rkick (.p(n02),.n(\0 ));
not1 #() X01 (.z(n03),.a(n02),.vss(\0 ),.vdd(n01));
not1 #() X02 (.z(n04),.a(n03),.vss(\0 ),.vdd(n01));
